
# First Order Logic Knowledge Base using Forward Chaining

# Knowledge Base: Facts
facts = {
    ("Human", "Socrates"),
    ("Human", "Plato"),
    ("Mortal", "Plato")
}

# Knowledge Base: Rules
# Format: (premises, conclusion)

rules = [
    ([("Human", "?x")], ("Mortal", "?x"))
]

# Function to match variables with facts
def unify(pattern, fact, substitution=None):
    if substitution is None:
        substitution = {}

    if pattern[0] != fact[0]:
        return None

    if pattern[1].startswith("?"):
        variable = pattern[1]

        if variable in substitution:
            if substitution[variable] != fact[1]:
                return None
        else:
            substitution[variable] = fact[1]

    elif pattern[1] != fact[1]:
        return None

    return substitution


# Forward Chaining Algorithm
def forward_chaining(facts, rules, query):

    knowledge_base = set(facts)

    print("Initial Knowledge Base:")
    for fact in knowledge_base:
        print(fact)

    changed = True

    while changed:
        changed = False

        for premises, conclusion in rules:

            # Find substitutions satisfying all premises
            substitutions = [{}]

            for premise in premises:
                new_substitutions = []

                for substitution in substitutions:
                    for fact in knowledge_base:
                        result = unify(
                            premise, fact, substitution.copy()
                        )

                        if result is not None:
                            new_substitutions.append(result)

                substitutions = new_substitutions

            # Derive new facts
            for substitution in substitutions:
                new_fact = tuple(
                    substitution.get(item, item)
                    if isinstance(item, str) else item
                    for item in conclusion
                )

                if new_fact not in knowledge_base:
                    knowledge_base.add(new_fact)
                    changed = True
                    print("Derived:", new_fact)

    print("\nFinal Knowledge Base:")
    for fact in knowledge_base:
        print(fact)

    # Check query
    if query in knowledge_base:
        print("\nQuery", query, "is PROVED!")
        return True
    else:
        print("\nQuery", query, "cannot be proved.")
        return False


# Given Query
query = ("Mortal", "Socrates")

# Execute Forward Chaining
forward_chaining(facts, rules, query)
