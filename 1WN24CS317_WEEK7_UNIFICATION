def unify(x, y, subst=None):
    if subst is None:
        subst = {}

    x = apply_substitution(x, subst)
    y = apply_substitution(y, subst)

    if x == y:
        return subst

    if is_variable(x):
        if occurs_check(x, y):
            return None
        subst[x] = y
        return subst

    if is_variable(y):
        if occurs_check(y, x):
            return None
        subst[y] = x
        return subst

    if isinstance(x, tuple) and isinstance(y, tuple):

        if x[0] != y[0] or len(x) != len(y):
            return None

        for a, b in zip(x[1:], y[1:]):
            subst = unify(a, b, subst)

            if subst is None:
                return None

        return subst

    return None


def is_variable(x):
    return isinstance(x, str) and x.startswith('?')


def apply_substitution(x, subst):
    if is_variable(x) and x in subst:
        return apply_substitution(subst[x], subst)

    if isinstance(x, tuple):
        return tuple(
            [x[0]] +
            [apply_substitution(a, subst) for a in x[1:]]
        )

    return x


def occurs_check(var, x):
    if var == x:
        return True

    if isinstance(x, tuple):
        return any(occurs_check(var, a) for a in x[1:])

    return False


def display(exp):
    return exp[0] + "(" + ", ".join(exp[1:]) + ")"


# Main Program

exp1 = ("Eats", "Riya", "?y")
exp2 = ("Eats", "?x", "Apple")

print("First Expression:", display(exp1))
print("Second Expression:", display(exp2))

result = unify(exp1, exp2)

if result is None:
    print("Unification Failed")
else:
    print("Unification Successful")
    print("Substitution:", result)

    print("Unified Expression:",
          display(apply_substitution(exp1, result)))
