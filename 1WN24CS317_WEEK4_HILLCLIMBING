def calculate_cost(state):

    n = len(state)
    cost = 0

    for i in range(n):
        for j in range(i + 1, n):
            # Same row or same diagonal
            if state[i] == state[j] or abs(state[i] - state[j]) == abs(i - j):
                cost += 1

    return cost


def get_neighbors(state):
    """Generate all states by moving one queen within its column."""
    n = len(state)
    neighbors = []

    for col in range(n):
        for row in range(1, n + 1):
            if row != state[col]:
                neighbor = state.copy()
                neighbor[col] = row
                neighbors.append(neighbor)

    return neighbors


def hill_climbing(initial_state):
    current = initial_state.copy()
    step = 0

    while True:
        current_cost = calculate_cost(current)

        print(f"\nStep {step}")
        print(f"Current state: {current}")
        print(f"Current cost: {current_cost}")

        if current_cost == 0:
            print("\nGoal configuration reached!")
            print_board(current)
            return current

        neighbors = get_neighbors(current)

        print("\nNeighbor states and their costs:")
        for neighbor in neighbors:
            print(f"{neighbor} -> Cost = {calculate_cost(neighbor)}")

        best_neighbor = min(neighbors, key=calculate_cost)
        best_cost = calculate_cost(best_neighbor)

        print(f"\nBest neighbor: {best_neighbor}")
        print(f"Best neighbor cost: {best_cost}")

        if best_cost >= current_cost:
            print("Local minimum reached. No better neighbor found.")
            return None

        current = best_neighbor
        step += 1


def print_board(state):
    n = len(state)
    for row in range(1, n + 1):
        print(" ".join("Q" if state[col] == row else "."
                       for col in range(n)))


initial_state = [1, 1, 1, 1, 1]

solution = hill_climbing(initial_state)
